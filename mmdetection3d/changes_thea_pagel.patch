+
+        random.shuffle(measurements)
+        train_samples = sum([
+            measurements[id]
+            for id in measurement_ids[:num_train]
+        ],
+            [],
+        )
+        val_samples = sum([
+            measurements[id]
+            for id in measurement_ids[num_train:num_train + num_val]
+        ],
+            [],
+        )
+        test_samples = sum([
+            measurements[id]
+            for id in measurement_ids[-num_test:]
